<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:loc="using:OscarWatch.Localization"
        xmlns:ctrl="using:OscarWatch.Controls"
        x:Class="OscarWatch.Views.QsoLogbookWindow"
        x:DataType="vm:QsoLogbookViewModel"
        Title="{loc:Localize Key=Window.Logbook.Title}"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.logbook-panel">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtlePanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.logbook-entry">
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.logbook-entry.station-live">
      <Setter Property="BorderBrush" Value="{DynamicResource GpsOkBrush}" />
      <Setter Property="BorderThickness" Value="2,1,1,1" />
    </Style>
    <Style Selector="Border.logbook-station.station-live">
      <Setter Property="BorderBrush" Value="{DynamicResource GpsOkBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="Border.call-status-badge.worked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassRecordingBadgeForegroundBrush}" />
    </Style>
    <Style Selector="Border.call-status-badge.not-worked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PassInProgressBadgeForegroundBrush}" />
    </Style>
    <Style Selector="Border.call-status-badge.worked">
      <Setter Property="Background" Value="{DynamicResource PassRecordingBadgeBackgroundBrush}" />
    </Style>
    <Style Selector="Border.call-status-badge.not-worked">
      <Setter Property="Background" Value="{DynamicResource PassInProgressBadgeBackgroundBrush}" />
    </Style>
    <Style Selector="DataGridRow:nth-child(2n)">
      <Setter Property="Background" Value="{DynamicResource ThemeInsetBackgroundBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="12">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{loc:Localize Key=Logbook.Menu.Logbook}">
        <MenuItem Header="{Binding CurrentLogbookDisplayName}" IsEnabled="False" />
        <Separator />
        <MenuItem Header="{loc:Localize Key=Logbook.NewLogbook}"
                  Click="OnNewLogbookClick" />
        <MenuItem Header="{loc:Localize Key=Logbook.EditLogbook}"
                  Click="OnEditLogbookClick"
                  IsEnabled="{Binding CanEditLogbook}" />
        <MenuItem Header="{loc:Localize Key=Logbook.Menu.DeleteLogbook}"
                  Click="OnDeleteLogbookClick"
                  IsEnabled="{Binding CanDeleteLogbook}" />
        <Separator />
        <MenuItem ItemsSource="{Binding LogbookSwitchItems}">
          <MenuItem.DataTemplates>
            <DataTemplate DataType="vm:LogbookSwitchMenuItemViewModel">
              <MenuItem Header="{Binding Name}"
                        Command="{Binding SelectCommand}"
                        ToggleType="Radio"
                        IsChecked="{Binding IsChecked}" />
            </DataTemplate>
          </MenuItem.DataTemplates>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{loc:Localize Key=Logbook.Menu.Edit}">
        <MenuItem Header="{loc:Localize Key=Logbook.EditQso}"
                  Command="{Binding BeginEditSelectedQsoCommand}" />
        <MenuItem Header="{loc:Localize Key=Logbook.DeleteQso}"
                  Click="OnDeleteQsoClick" />
      </MenuItem>
      <MenuItem Header="{loc:Localize Key=Logbook.Menu.Export}">
        <MenuItem Header="{loc:Localize Key=Logbook.ExportAdif}"
                  Click="OnExportAdifClick"
                  IsEnabled="{Binding CanExport}" />
      </MenuItem>
      <MenuItem Header="{loc:Localize Key=Logbook.Menu.Settings}"
                Click="OnSettingsClick"
                IsEnabled="{Binding CanEditLogbook}" />
      <MenuItem Header="{loc:Localize Key=Logbook.Menu.UpdateCountryFile}"
                Command="{Binding UpdateCountryFileCommand}" />
    </Menu>

    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0"
            Margin="0,10,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0"
                   Text="{Binding QsoCountText}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   IsVisible="{Binding ShowQsoCountText}" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding StationStatusText}"
                   VerticalAlignment="Center"
                   TextAlignment="Right"
                   Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
      </Grid>
    </Border>

    <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,10,0,0">
      <Border Grid.Row="0"
              Classes="logbook-panel logbook-entry"
              Classes.station-live="{Binding StationAvailable}">
        <Border.Styles>
          <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
          </Style>
          <Style Selector="TextBox.grid-entry.grid-valid">
            <Setter Property="BorderBrush" Value="{DynamicResource GpsOkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
          <Style Selector="TextBox.grid-entry.grid-invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource PassRecordingBadgeBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
          <Style Selector="TextBox.call-entry.worked">
            <Setter Property="BorderBrush" Value="{DynamicResource PassRecordingBadgeBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
          <Style Selector="TextBox.call-entry.not-worked">
            <Setter Property="BorderBrush" Value="{DynamicResource GpsOkBrush}" />
            <Setter Property="BorderThickness" Value="2" />
          </Style>
          <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
          </Style>
          <Style Selector="ComboBox.rst-entry">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="ComboBox.rst-entry /template/ TextBox#PART_EditableTextBox">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
          </Style>
          <Style Selector="ComboBox.rst-entry /template/ TextBox#PART_EditableTextBox /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="TextAlignment" Value="Center" />
          </Style>
          <Style Selector="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
          </Style>
          <Style Selector="DatePicker">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
          </Style>
          <Style Selector="TimePicker">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
          </Style>
        </Border.Styles>
        <StackPanel Spacing="10">
          <Border Background="{DynamicResource ThemeInsetBackgroundBrush}"
                  CornerRadius="4"
                  Padding="8,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Grid.Column="0"
                         Text="{loc:Localize Key=Logbook.UtcClockLabel}"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding UtcClock}"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold"
                         FontFamily="Consolas,Courier New,monospace" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding EditingStatusText}"
                     IsVisible="{Binding IsEditingQso}"
                     Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                     FontStyle="Italic" />
          <Grid ColumnDefinitions="Auto,Auto,160"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="4"
                IsVisible="{Binding IsEditingQso}">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{loc:Localize Key=Logbook.QsoDate}"
                       FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{loc:Localize Key=Logbook.QsoTime}"
                       FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{loc:Localize Key=Logbook.Column.Mode}"
                       FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <DatePicker Grid.Row="1" Grid.Column="0"
                        SelectedDate="{Binding EditQsoDate, Mode=TwoWay}"
                        DayFormat="dd"
                        MonthFormat="MM"
                        YearFormat="yyyy"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        Loaded="OnQsoWhenLoaded"
                        KeyDown="OnEntryKeyDown" />
            <TimePicker Grid.Row="1" Grid.Column="1"
                        SelectedTime="{Binding EditQsoTime, Mode=TwoWay}"
                        ClockIdentifier="{Binding EditClockIdentifier}"
                        UseSeconds="True"
                        MinWidth="280"
                        HorizontalAlignment="Left"
                        Loaded="OnQsoWhenLoaded"
                        KeyDown="OnEntryKeyDown" />
            <ComboBox Grid.Row="1" Grid.Column="2"
                      ItemsSource="{Binding ModeOptions}"
                      Text="{Binding EditMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      MinWidth="140"
                      HorizontalAlignment="Stretch"
                      KeyDown="OnEntryKeyDown" />
          </Grid>
          <Grid ColumnDefinitions="*,72,72,*,*,*,Auto,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{loc:Localize Key=Logbook.Call}" FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{loc:Localize Key=Logbook.RstSent}" FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="{loc:Localize Key=Logbook.RstRcvd}" FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="3"
                       Text="{loc:Localize Key=Logbook.Grid}" FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="4"
                       Text="{loc:Localize Key=Logbook.Name}" FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="5"
                       Text="{loc:Localize Key=Logbook.Comment}" FontSize="12"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="6"
                       Text="&#160;" FontSize="12"
                       IsVisible="{Binding !ShowCancelEdit}" />
            <TextBlock Grid.Row="0" Grid.Column="7"
                       Text="&#160;" FontSize="12"
                       IsVisible="{Binding ShowCancelEdit}" />

            <TextBox Grid.Row="1" Grid.Column="0"
                     x:Name="CallTextBox"
                     Classes="call-entry"
                     Classes.worked="{Binding DxccEntityIsWorked}"
                     Classes.not-worked="{Binding DxccEntityIsNew}"
                     ctrl:UppercaseTextInput.IsEnabled="True"
                     Text="{Binding Call, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="24"
                     KeyDown="OnEntryKeyDown" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      Classes="rst-entry"
                      ItemsSource="{Binding RstOptions}"
                      Text="{Binding RstSent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      KeyDown="OnEntryKeyDown">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             TextAlignment="Center"
                             HorizontalAlignment="Stretch" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Row="1" Grid.Column="2"
                      Classes="rst-entry"
                      ItemsSource="{Binding RstOptions}"
                      Text="{Binding RstRcvd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      KeyDown="OnEntryKeyDown">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             TextAlignment="Center"
                             HorizontalAlignment="Stretch" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Row="1" Grid.Column="3"
                     Classes="grid-entry"
                     Classes.grid-valid="{Binding GridValidationIsValid}"
                     Classes.grid-invalid="{Binding GridValidationIsInvalid}"
                     ctrl:UppercaseTextInput.IsEnabled="True"
                     Text="{Binding Grid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="40"
                     KeyDown="OnEntryKeyDown" />
            <TextBox Grid.Row="1" Grid.Column="4"
                     Text="{Binding Name, Mode=TwoWay}"
                     KeyDown="OnEntryKeyDown" />
            <TextBox Grid.Row="1" Grid.Column="5"
                     Text="{Binding Comment, Mode=TwoWay}"
                     KeyDown="OnEntryKeyDown" />

            <Button Grid.Row="1" Grid.Column="6"
                    Content="{Binding EntryCommitLabel}"
                    Command="{Binding CommitQsoCommand}"
                    Classes="accent"
                    MinWidth="88"
                    Click="OnCommitQsoClick" />
            <Button Grid.Row="1" Grid.Column="7"
                    Content="{loc:Localize Key=Logbook.CancelEdit}"
                    Command="{Binding CancelEditQsoCommand}"
                    IsVisible="{Binding ShowCancelEdit}"
                    MinWidth="88"
                    Click="OnCancelEditClick" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="call-status-badge"
                    Classes.worked="{Binding DxccEntityIsWorked}"
                    Classes.not-worked="{Binding DxccEntityIsNew}"
                    IsVisible="{Binding ShowDxccBadge}"
                    Padding="8,3"
                    CornerRadius="4"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding DxccBadgeText}"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{Binding CallHint}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <DockPanel Grid.Row="1">
        <Border DockPanel.Dock="Top"
                Classes="logbook-panel"
                Padding="6"
                Margin="0,0,0,10"
                IsVisible="{Binding ShowCwKeyer}">
          <Border.Styles>
            <Style Selector="Button.cw-macro">
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="Padding" Value="4,3" />
              <Setter Property="Margin" Value="2,0" />
            </Style>
            <Style Selector="Button.cw-macro.cw-active">
              <Setter Property="Background" Value="{DynamicResource PassRecordingBadgeBackgroundBrush}" />
            </Style>
            <Style Selector="Button.cw-macro.cw-active TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource PassRecordingBadgeForegroundBrush}" />
            </Style>
          </Border.Styles>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding CwButtons}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CwMacroButtonViewModel">
                  <Button Classes="cw-macro"
                          Classes.cw-active="{Binding IsActive}"
                          Command="{Binding SendCommand}"
                          Focusable="False"
                          ToolTip.Tip="{Binding ToolTip}"
                          ToolTip.ShowOnDisabled="True"
                          AutomationProperties.Name="{Binding ToolTip}">
                    <StackPanel>
                      <TextBlock Text="{Binding KeyName}"
                                 FontSize="10"
                                 HorizontalAlignment="Center"
                                 Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
                      <TextBlock Text="{Binding Label}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 MinHeight="16"
                                 HorizontalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="1"
                    Content="{loc:Localize Key=Logbook.Cw.Stop}"
                    Command="{Binding StopCwCommand}"
                    Focusable="False"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    MinWidth="64"
                    ToolTip.Tip="{loc:Localize Key=Logbook.Cw.StopToolTip}" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Localize Key=Logbook.Cw.WpmToolTip}">
              <NumericUpDown Value="{Binding CwWpm, Mode=TwoWay}"
                             Minimum="5" Maximum="60" Increment="1"
                             FormatString="0"
                             Width="110"
                             AutomationProperties.Name="{loc:Localize Key=Logbook.Cw.WpmToolTip}" />
              <TextBlock Text="{loc:Localize Key=Logbook.Cw.Wpm}"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,260" ColumnSpacing="10">
          <Border Grid.Column="0"
                  Classes="logbook-panel"
                  Padding="4,4,4,6">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top"
                         Text="{loc:Localize Key=Logbook.History}"
                         Margin="8,4,8,8"
                         FontWeight="SemiBold" />
              <DataGrid x:Name="QsoHistoryGrid"
                        Background="Transparent"
                        ItemsSource="{Binding QsoRows}"
                        SelectedItem="{Binding SelectedQso, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserReorderColumns="False"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        PointerPressed="OnQsoHistoryPointerPressed">
                <DataGrid.Styles>
                  <Style Selector="TextBlock.cloudlog-sent">
                    <Setter Property="Foreground" Value="{DynamicResource GpsOkBrush}" />
                  </Style>
                  <Style Selector="TextBlock.cloudlog-pending">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryForegroundBrush}" />
                  </Style>
                  <Style Selector="TextBlock.cloudlog-failed">
                    <Setter Property="Foreground" Value="{DynamicResource PassRecordingBadgeBackgroundBrush}" />
                  </Style>
                </DataGrid.Styles>
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{loc:Localize Key=Logbook.EditQso}"
                              Command="{Binding BeginEditSelectedQsoCommand}" />
                    <MenuItem Header="{loc:Localize Key=Logbook.ReuploadCloudlog}"
                              Command="{Binding ReuploadSelectedQsoCommand}" />
                    <MenuItem Header="{loc:Localize Key=Logbook.DeleteQso}"
                              Click="OnDeleteQsoClick" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.DateTime}"
                                      Binding="{Binding DateTimeText}"
                                      Width="168" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.Call}"
                                      Binding="{Binding Call}"
                                      Width="90" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.Country}"
                                      Binding="{Binding Country}"
                                      Width="110" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.Grid}"
                                      Binding="{Binding Grid}"
                                      Width="70" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.Satellite}"
                                      Binding="{Binding Satellite}"
                                      Width="80" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.Mode}"
                                      Binding="{Binding Mode}"
                                      Width="70" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.RstSent}"
                                      Binding="{Binding RstSent}"
                                      Width="52" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.RstRcvd}"
                                      Binding="{Binding RstRcvd}"
                                      Width="52" />
                  <DataGridTextColumn Header="{loc:Localize Key=Logbook.Column.Comment}"
                                      Binding="{Binding Comment}"
                                      Width="*" />
                  <DataGridTemplateColumn Header="{loc:Localize Key=Logbook.Column.Cloudlog}"
                                          Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="vm:QsoRowViewModel">
                        <Border MinWidth="20"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="{Binding CloudlogStatusToolTip}">
                          <TextBlock Text="{Binding CloudlogStatusGlyph}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Classes.cloudlog-sent="{Binding CloudlogStatusIsSent}"
                                     Classes.cloudlog-pending="{Binding CloudlogStatusIsPending}"
                                     Classes.cloudlog-failed="{Binding CloudlogStatusIsFailed}" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <Border Grid.Column="1"
                  Classes="logbook-panel logbook-station"
                  Classes.station-live="{Binding StationAvailable}"
                  Padding="12">
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Localize Key=Logbook.StationControl}"
                         FontWeight="SemiBold" />
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=Logbook.Station.Satellite}" FontSize="12"
                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
                <TextBlock Text="{Binding StationSatellite}"
                           FontWeight="SemiBold"
                           FontFamily="Consolas,Courier New,monospace" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=Logbook.Station.Mode}" FontSize="12"
                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
                <TextBlock Text="{Binding StationMode}" FontFamily="Consolas,Courier New,monospace" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=Logbook.Station.Frequencies}" FontSize="12"
                           Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
                <TextBlock Text="{Binding StationFrequencies}" FontFamily="Consolas,Courier New,monospace" />
              </StackPanel>
              <TextBlock Text="{loc:Localize Key=Logbook.Station.Note}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
