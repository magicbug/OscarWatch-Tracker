<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:ft4ui="using:OscarWatch.Ft4"
        xmlns:ft4core="using:OscarWatch.Core.Ft4"
        xmlns:loc="using:OscarWatch.Localization"
        x:Class="OscarWatch.Views.Ft4SettingsWindow"
        x:DataType="vm:Ft4ViewModel"
        Title="{loc:Localize Key=Window.Ft4Settings.Title}"
        Width="600"
        Height="640"
        MinWidth="540"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="{loc:Localize Key=Common.Close}"
              Classes="dialog-footer"
              Click="OnCloseClick"
              IsDefault="True"
              IsCancel="True"
              MinWidth="100" />
    </StackPanel>

    <TabControl>
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="TextBlock.ft4-section">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.ft4-note">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryForegroundBrush}" />
        </Style>
        <Style Selector="Separator.ft4-rule">
          <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
      </TabControl.Styles>

      <TabItem Header="{loc:Localize Key=Ft4.Settings.AudioSection}">
        <ScrollViewer Margin="8,10,4,4" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="10" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Audio.Input}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding InputDeviceOptions}"
                        SelectedItem="{Binding SelectedInputDevice}"
                        HorizontalAlignment="Stretch"
                        MinWidth="260" />
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Audio.Output}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding OutputDeviceOptions}"
                        SelectedItem="{Binding SelectedOutputDevice}"
                        HorizontalAlignment="Stretch"
                        MinWidth="260" />
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.TxLevel}"
                         VerticalAlignment="Center" />
              <DockPanel Grid.Row="2" Grid.Column="1">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding TxLevel, StringFormat={}{0:P0}}"
                           VerticalAlignment="Center"
                           MinWidth="44"
                           Margin="8,0,0,0" />
                <Slider Minimum="0.05"
                        Maximum="1"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Value="{Binding TxLevel}" />
              </DockPanel>
              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.TxLevelMeter}"
                         VerticalAlignment="Center" />
              <ProgressBar Grid.Row="3" Grid.Column="1"
                           Minimum="0"
                           Maximum="100"
                           Value="{Binding TxPlaybackPeakPercent}"
                           Height="12"
                           VerticalAlignment="Center" />
              <Button Grid.Row="4" Grid.Column="1"
                      Content="{loc:Localize Key=Common.Refresh}"
                      Command="{Binding RefreshDevicesCommand}"
                      HorizontalAlignment="Right"
                      MinWidth="100" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Ft4.Settings.PttSection}">
        <ScrollViewer Margin="8,10,4,4" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8"
                  RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.PttMethod}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding PttMethodOptions}"
                        SelectedItem="{Binding SelectedPttMethod}"
                        HorizontalAlignment="Stretch"
                        MinWidth="260" />
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Ptt.LeadMs}"
                         VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1"
                             Value="{Binding PttLeadMs, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="2000"
                             Increment="10"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="120" />
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Ptt.TailMs}"
                         VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1"
                             Value="{Binding PttTailMs, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="2000"
                             Increment="10"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="120" />
            </Grid>

            <StackPanel Spacing="8" IsVisible="{Binding ShowHandshakePttOptions}">
              <Separator Classes="ft4-rule" />
              <TextBlock Classes="ft4-section"
                         Text="{loc:Localize Key=Ft4.Settings.Group.ControlLine}" />
              <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0"
                           Text="{loc:Localize Key=Ft4.Ptt.Line}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding PttLineOptions}"
                          SelectedItem="{Binding SelectedPttLine}"
                          MinWidth="90" />
                <CheckBox Grid.Column="2"
                          Content="{loc:Localize Key=Ft4.Ptt.Invert}"
                          IsChecked="{Binding PttInvert}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="{loc:Localize Key=Ft4.Ptt.SeparatePort}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           IsVisible="{Binding ShowSeparatePttPort}" />
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding PttPortOptions}"
                          SelectedItem="{Binding SeparatePttPort}"
                          MinWidth="120"
                          IsVisible="{Binding ShowSeparatePttPort}" />
              </Grid>
            </StackPanel>

            <TextBlock Text="{Binding SeparatePttConflictText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PassInProgressBadgeForegroundBrush}"
                       FontWeight="SemiBold"
                       IsVisible="{Binding ShowSeparatePttConflict}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Ft4.Settings.ModemSection}">
        <ScrollViewer Margin="8,10,4,4" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock Classes="ft4-section"
                       Text="{loc:Localize Key=Ft4.Settings.Group.Contacts}" />
            <CheckBox Content="{loc:Localize Key=Ft4.AutoReply}"
                      IsChecked="{Binding AutoReply, Mode=TwoWay}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.AutoReply.Note}" />
            <TextBlock Classes="ft4-section"
                       Margin="0,4,0,0"
                       Text="{loc:Localize Key=Ft4.BlockedCallsigns}" />
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.BlockedCallsigns.Note}" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0"
                       Text="{Binding BlockedCallsignDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="{loc:Localize Key=Ft4.BlockedCallsigns.Placeholder}"
                       AutomationProperties.Name="{loc:Localize Key=Ft4.BlockedCallsigns}"
                       KeyDown="OnBlockedCallsignKeyDown" />
              <Button Grid.Column="1"
                      Content="{loc:Localize Key=Common.Add}"
                      Command="{Binding AddBlockedCallsignCommand}"
                      MinWidth="80" />
              <Button Grid.Column="2"
                      Content="{loc:Localize Key=Ft4.BlockedCallsigns.Remove}"
                      Command="{Binding RemoveBlockedCallsignCommand}"
                      MinWidth="88" />
            </Grid>
            <ListBox ItemsSource="{Binding BlockedCallsigns}"
                     SelectedItem="{Binding SelectedBlockedCallsign, Mode=TwoWay}"
                     Height="120"
                     FontSize="13"
                     AutomationProperties.Name="{loc:Localize Key=Ft4.BlockedCallsigns}" />
            <CheckBox Content="{loc:Localize Key=Ft4.ApEnabled}"
                      IsChecked="{Binding ApEnabled}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.ApEnabled.Note}" />
            <CheckBox Content="{loc:Localize Key=Ft4.HoldTxFrequency}"
                      IsChecked="{Binding HoldTxFrequency}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.HoldTxFrequency.Note}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.TxWatchdogMinutes}"
                         VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding TxWatchdogMinutes, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="30"
                             Increment="1"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="120" />
            </Grid>
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.TxWatchdogMinutes.Note}" />
            <CheckBox Content="{loc:Localize Key=Ft4.AutoLowerRfPower}"
                      IsChecked="{Binding AutoLowerRfPower}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.AutoLowerRfPower.Note}" />

            <Separator Classes="ft4-rule" />
            <TextBlock Classes="ft4-section"
                       Text="{loc:Localize Key=Ft4.Settings.Group.Doppler}" />
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.Settings.Group.DopplerNote}" />
            <CheckBox Content="{loc:Localize Key=Ft4.AudioDopplerTx}"
                      IsChecked="{Binding AudioDopplerTx}" />
            <CheckBox Content="{loc:Localize Key=Ft4.AudioDopplerRx}"
                      IsChecked="{Binding AudioDopplerRx}" />
            <CheckBox Content="{loc:Localize Key=Ft4.ParallelTxEchoDecode}"
                      IsChecked="{Binding ParallelTxEchoDecode}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.ParallelTxEchoDecode.Note}" />
            <CheckBox Content="{loc:Localize Key=Ft4.ShowDtWsjtxConvention}"
                      IsChecked="{Binding ShowDtWsjtxConvention}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.ShowDtWsjtxConvention.Note}" />

            <Separator Classes="ft4-rule" />
            <TextBlock Classes="ft4-section"
                       Text="{loc:Localize Key=Ft4.Settings.Group.DecoderTesting}" />
            <CheckBox Content="{loc:Localize Key=Ft4.SaveSlotAudio}"
                      IsChecked="{Binding SaveSlotAudio}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.SaveSlotAudio.Note}" />
            <Button Margin="24,0,0,0"
                    Content="{loc:Localize Key=Ft4.SaveSlotAudio.OpenFolder}"
                    Command="{Binding OpenSlotRecordingFolderCommand}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Ft4.Settings.Group.Reporting}">
        <ScrollViewer Margin="8,10,4,4" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <CheckBox Content="{loc:Localize Key=Ft4.PskReporter}"
                      IsChecked="{Binding PskReporterEnabled}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.PskReporter.Note}" />
            <CheckBox Content="{loc:Localize Key=Ft4.OscarWatchSpots}"
                      IsChecked="{Binding OscarWatchSpotsEnabled}"
                      IsEnabled="{Binding OscarWatchSpotsTokenAvailable}" />
            <TextBlock Classes="ft4-note"
                       Margin="24,0,0,0"
                       Text="{loc:Localize Key=Ft4.OscarWatchSpots.Note}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Ft4.Settings.AppearanceSection}">
        <ScrollViewer Margin="8,10,4,4" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock Classes="ft4-section"
                       Text="{loc:Localize Key=Ft4.Settings.Group.Waterfall}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.WaterfallRange}"
                         VerticalAlignment="Center" />
              <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding WaterfallRangeDb, StringFormat={}{0:0} dB}"
                           VerticalAlignment="Center"
                           MinWidth="52"
                           Margin="8,0,0,0" />
                <Slider Minimum="{x:Static ft4core:Ft4Settings.MinWaterfallRangeDb}"
                        Maximum="{x:Static ft4core:Ft4Settings.MaxWaterfallRangeDb}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding WaterfallRangeDb, Mode=TwoWay}" />
              </DockPanel>
            </Grid>
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.WaterfallRange.Note}" />

            <Separator Classes="ft4-rule" />
            <TextBlock Classes="ft4-section"
                       Text="{loc:Localize Key=Ft4.Settings.Group.DecodeList}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.DecodeFontSize}"
                         VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding DecodeFontSize, Mode=TwoWay}"
                             Minimum="10"
                             Maximum="28"
                             Increment="1"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="120" />
            </Grid>
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.DecodeFontSize.Note}" />
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.Decode.ColourNote}" />
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Classes="ft4-note"
                         Text="{loc:Localize Key=Ft4.Decode.Background}" />
              <TextBlock Grid.Row="0" Grid.Column="2"
                         Classes="ft4-note"
                         Text="{loc:Localize Key=Ft4.Decode.Text}" />
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Decode.CallingMe}"
                         VerticalAlignment="Center" />
              <ColorPicker Grid.Row="1" Grid.Column="1"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="True"
                           Color="{Binding CallingMeColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4HexColorConverter.Instance}}" />
              <ColorPicker Grid.Row="1" Grid.Column="2"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="False"
                           Color="{Binding CallingMeTextColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4TextColorConverter.Instance}}" />
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Decode.Replying}"
                         VerticalAlignment="Center" />
              <ColorPicker Grid.Row="2" Grid.Column="1"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="True"
                           Color="{Binding ReplyingColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4HexColorConverter.Instance}}" />
              <ColorPicker Grid.Row="2" Grid.Column="2"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="False"
                           Color="{Binding ReplyingTextColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4TextColorConverter.Instance}}" />
              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Decode.Cq}"
                         VerticalAlignment="Center" />
              <ColorPicker Grid.Row="3" Grid.Column="1"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="True"
                           Color="{Binding CqColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4HexColorConverter.Instance}}" />
              <ColorPicker Grid.Row="3" Grid.Column="2"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="False"
                           Color="{Binding CqTextColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4TextColorConverter.Instance}}" />
              <TextBlock Grid.Row="4" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Decode.NewCall}"
                         VerticalAlignment="Center" />
              <ColorPicker Grid.Row="4" Grid.Column="1"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="True"
                           Color="{Binding NewCallColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4HexColorConverter.Instance}}" />
              <ColorPicker Grid.Row="4" Grid.Column="2"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="False"
                           Color="{Binding NewCallTextColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4TextColorConverter.Instance}}" />
              <TextBlock Grid.Row="5" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Decode.NewGrid}"
                         VerticalAlignment="Center" />
              <ColorPicker Grid.Row="5" Grid.Column="1"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="True"
                           Color="{Binding NewGridColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4HexColorConverter.Instance}}" />
              <ColorPicker Grid.Row="5" Grid.Column="2"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="False"
                           Color="{Binding NewGridTextColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4TextColorConverter.Instance}}" />
              <TextBlock Grid.Row="6" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.Decodes.Tx}"
                         VerticalAlignment="Center" />
              <ColorPicker Grid.Row="6" Grid.Column="2"
                           HorizontalAlignment="Left"
                           IsAlphaEnabled="False"
                           Color="{Binding TxTextColour, Mode=TwoWay, Converter={x:Static ft4ui:Ft4HexColorConverter.Instance}}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{loc:Localize Key=Ft4.Settings.EchoSection}">
        <ScrollViewer Margin="8,10,4,4" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="8">
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.EchoCalibration.Note}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="8"
                  RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.EchoCalibration.Satellite}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding EchoCalibrationEntries}"
                        SelectedItem="{Binding SelectedEchoCalibrationEntry}"
                        HorizontalAlignment="Stretch"
                        MinWidth="260"
                        IsEnabled="{Binding HasEchoCalibrationSatellite}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{loc:Localize Key=Ft4.EchoCalibration.TrimHz}"
                         VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1"
                             Value="{Binding EchoCalibrationHz, Mode=TwoWay}"
                             Minimum="-20000"
                             Maximum="20000"
                             Increment="10"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="140"
                             IsEnabled="{Binding HasEchoCalibrationSatellite}" />
              <StackPanel Grid.Row="2" Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8">
                <Button Content="{loc:Localize Key=Ft4.EchoCalibration.Clear}"
                        Command="{Binding ClearEchoCalibrationCommand}"
                        MinWidth="100" />
                <Button Content="{loc:Localize Key=Ft4.EchoCalibration.ClearAll}"
                        Command="{Binding ClearAllEchoCalibrationsCommand}"
                        MinWidth="100" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="ft4-note"
                       Text="{loc:Localize Key=Ft4.EchoCalibration.NoSatellite}"
                       IsVisible="{Binding !HasEchoCalibrationSatellite}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
