<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:controls="using:OscarWatch.Controls"
        xmlns:loc="using:OscarWatch.Localization"
        x:Class="OscarWatch.Views.Ft4Window"
        x:DataType="vm:Ft4ViewModel"
        Title="{loc:Localize Key=Window.Ft4.Title}"
        Width="900" Height="720"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.ft4-panel">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtlePanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBlock.ft4-meta">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.ft4-mono">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Same typeface as values so label/value baselines match on the status strip. -->
    <Style Selector="TextBlock.ft4-status-label">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.ft4-slot">
      <Setter Property="Height" Value="10" />
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Foreground" Value="#3D9E6F" />
    </Style>
    <Style Selector="ProgressBar.ft4-slot.tx">
      <Setter Property="Foreground" Value="#C44B4B" />
    </Style>
    <Style Selector="TextBlock.ft4-slot-rx">
      <Setter Property="Foreground" Value="#3D9E6F" />
    </Style>
    <Style Selector="TextBlock.ft4-slot-tx">
      <Setter Property="Foreground" Value="#C44B4B" />
    </Style>
    <!-- Sits on the always-dark waterfall, so the colours stay light in either theme. -->
    <Style Selector="Border.ft4-station-warning">
      <Setter Property="Background" Value="#F0121008" />
      <Setter Property="BorderBrush" Value="#FFB300" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.ft4-station-warning TextBlock.ft4-station-title">
      <Setter Property="Foreground" Value="#FFD56A" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ft4-station-warning TextBlock.ft4-station-body">
      <Setter Property="Foreground" Value="#F4F1EA" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.ft4-decodes">
      <Setter Property="FontFamily" Value="Consolas,Courier New,monospace" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.ft4-decodes ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Header and rows share column widths per list, so they stay aligned and grow with the font size. -->
    <DataTemplate x:Key="Ft4DecodeHeaderTemplate" x:DataType="vm:Ft4ViewModel">
      <Grid ColumnSpacing="10"
            Margin="4,0,4,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="Ft4Utc" />
          <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="Ft4Kind" />
          <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="Ft4Dt" />
          <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Ft4Snr" />
          <ColumnDefinition Width="Auto" MinWidth="52" SharedSizeGroup="Ft4Hz" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{loc:Localize Key=Ft4.Decodes.Time}"
                   Classes="ft4-meta"
                   FontWeight="SemiBold"
                   FontSize="{Binding DecodeFontSize}" />
        <TextBlock Grid.Column="1"
                   Text="{loc:Localize Key=Ft4.Decodes.Kind}"
                   Classes="ft4-meta"
                   FontWeight="SemiBold"
                   FontSize="{Binding DecodeFontSize}" />
        <TextBlock Grid.Column="2"
                   Text="{loc:Localize Key=Ft4.Decodes.Dt}"
                   Classes="ft4-meta"
                   FontWeight="SemiBold"
                   FontSize="{Binding DecodeFontSize}" />
        <TextBlock Grid.Column="3"
                   Text="{loc:Localize Key=Ft4.Decodes.Snr}"
                   Classes="ft4-meta"
                   FontWeight="SemiBold"
                   FontSize="{Binding DecodeFontSize}" />
        <TextBlock Grid.Column="4"
                   Text="{loc:Localize Key=Ft4.Decodes.Hz}"
                   Classes="ft4-meta"
                   FontWeight="SemiBold"
                   FontSize="{Binding DecodeFontSize}"
                   HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5"
                   Text="{loc:Localize Key=Ft4.Decodes.Message}"
                   Classes="ft4-meta"
                   FontWeight="SemiBold"
                   FontSize="{Binding DecodeFontSize}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Ft4DecodeRowTemplate" x:DataType="vm:Ft4DecodeRowViewModel">
      <Grid ColumnSpacing="10" Margin="4,2"
            Background="{Binding RowBackground}"
            PointerPressed="OnDecodeRowPointerPressed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="76" SharedSizeGroup="Ft4Utc" />
          <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="Ft4Kind" />
          <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="Ft4Dt" />
          <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Ft4Snr" />
          <ColumnDefinition Width="Auto" MinWidth="52" SharedSizeGroup="Ft4Hz" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.Styles>
          <Style Selector="TextBlock.ft4-ink">
            <Setter Property="Foreground" Value="{Binding RowForeground}" />
          </Style>
        </Grid.Styles>
        <TextBlock Grid.Column="0"
                   Classes.ft4-ink="{Binding HasRowForeground}"
                   Text="{Binding Message.SlotUtc, StringFormat={}{0:HH:mm:ss}}" />
        <TextBlock Grid.Column="1"
                   Text="{loc:Localize Key=Ft4.Decodes.Tx}"
                   FontWeight="SemiBold"
                   Foreground="{Binding TxForeground}"
                   IsVisible="{Binding Message.IsTransmitted}" />
        <TextBlock Grid.Column="1"
                   Text="{loc:Localize Key=Ft4.Decodes.Echo}"
                   FontWeight="SemiBold"
                   Foreground="#6DB3F2"
                   IsVisible="{Binding Message.IsOwnEcho}" />
        <TextBlock Grid.Column="1"
                   Text="{loc:Localize Key=Ft4.Decodes.Ap}"
                   FontWeight="SemiBold"
                   Foreground="#E0A84A"
                   IsVisible="{Binding Message.IsAcceptedApriori}" />
        <TextBlock Grid.Column="1"
                   Text="{loc:Localize Key=Ft4.Decodes.Ap}"
                   FontWeight="SemiBold"
                   Foreground="#E0A84A"
                   TextDecorations="Strikethrough"
                   ToolTip.Tip="{loc:Localize Key=Ft4.Decodes.ApRejected.Tip}"
                   AutomationProperties.Name="{loc:Localize Key=Ft4.Decodes.ApRejected.Tip}"
                   IsVisible="{Binding Message.IsRejectedApriori}" />
        <TextBlock Grid.Column="1"
                   Classes.ft4-ink="{Binding HasRowForeground}"
                   Text="{loc:Localize Key=Ft4.Decodes.Pounce}"
                   FontWeight="SemiBold"
                   ToolTip.Tip="{loc:Localize Key=Ft4.Decodes.Pounce.Tip}"
                   AutomationProperties.Name="{loc:Localize Key=Ft4.Decodes.Pounce.Tip}"
                   IsVisible="{Binding IsPounceTarget}" />
        <TextBlock Grid.Column="2"
                   Classes.ft4-ink="{Binding HasRowForeground}"
                   Text="{Binding DtText}"
                   IsVisible="{Binding Message.IsReceiveActivity}" />
        <TextBlock Grid.Column="2"
                   Text="{Binding DtText}"
                   Foreground="#6DB3F2"
                   IsVisible="{Binding Message.IsOwnEcho}" />
        <TextBlock Grid.Column="2"
                   Text="-"
                   Opacity="0.45"
                   IsVisible="{Binding Message.IsTransmitted}" />
        <TextBlock Grid.Column="3"
                   Classes.ft4-ink="{Binding HasRowForeground}"
                   Text="{Binding Message.SnrDb, StringFormat={}{0:+0;-0;0} dB}"
                   IsVisible="{Binding Message.IsReceiveActivity}" />
        <TextBlock Grid.Column="3"
                   Text="{Binding Message.SnrDb, StringFormat={}{0:+0;-0;0} dB}"
                   Foreground="#6DB3F2"
                   IsVisible="{Binding Message.IsOwnEcho}" />
        <TextBlock Grid.Column="3"
                   Text="-"
                   Opacity="0.45"
                   IsVisible="{Binding Message.IsTransmitted}" />
        <TextBlock Grid.Column="4"
                   Classes.ft4-ink="{Binding HasRowForeground}"
                   Text="{Binding Message.FreqHz, StringFormat={}{0:0}}"
                   Opacity="0.9"
                   HorizontalAlignment="Right" />
        <TextBlock Grid.Column="5"
                   Text="{Binding Message.Text}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Message.Text}"
                   IsVisible="{Binding Message.IsTransmitted}"
                   Foreground="{Binding TxForeground}" />
        <TextBlock Grid.Column="5"
                   Text="{Binding Message.Text}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Message.Text}"
                   IsVisible="{Binding Message.IsOwnEcho}"
                   Foreground="#6DB3F2" />
        <TextBlock Grid.Column="5"
                   Classes.ft4-ink="{Binding HasRowForeground}"
                   Text="{Binding Message.Text}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Message.Text}"
                   IsVisible="{Binding Message.IsReceiveActivity}" />

      </Grid>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Edge-to-edge waterfall (top / left / right of the client area). -->
    <Grid DockPanel.Dock="Top" Height="200">
      <controls:Ft4WaterfallControl Spectrum="{Binding SpectrumBins}"
                                    Flatten="{Binding WaterfallFlatten}"
                                    TxAudioHz="{Binding TxAudioHz, Mode=TwoWay}"
                                    RxAudioHz="{Binding RxAudioHz, Mode=TwoWay}"
                                    HoldTxFrequency="{Binding HoldTxFrequency}"
                                    ShowTuningBrackets="{Binding !StationSetupMissing}"
                                    SlotSeconds="{Binding WaterfallSlotSeconds}"
                                    DecodeAgainCommand="{Binding DecodeAgainCommand}"
                                    DisplayRangeDb="{Binding WaterfallRangeDb}"
                                    StatusText="{Binding WaterfallStatusText}" />
      <Border Classes="ft4-station-warning"
              Margin="24,28"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              IsVisible="{Binding StationSetupMissing}"
              AutomationProperties.Name="{Binding StationSetupMessage}">
        <StackPanel Spacing="8">
          <TextBlock Classes="ft4-station-title"
                     Text="{loc:Localize Key=Ft4.Station.BannerTitle}" />
          <TextBlock Classes="ft4-station-body"
                     Text="{Binding StationSetupMessage}" />
          <Button Content="{loc:Localize Key=Ft4.Station.OpenSettings}"
                  Classes="dialog-footer accent"
                  HorizontalAlignment="Center"
                  MinWidth="180"
                  Click="OnEnterStationDetailsClick" />
        </StackPanel>
      </Border>
    </Grid>

    <DockPanel Margin="10">
    <!-- Status bar: slot progress, clock/Doppler, status -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0"
            Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0"
                     Text="{Binding SlotPeriodLabel}"
                     FontWeight="SemiBold"
                     MinWidth="28"
                     VerticalAlignment="Center"
                     Classes.ft4-slot-tx="{Binding IsTxSlot}"
                     Classes.ft4-slot-rx="{Binding !IsTxSlot}" />
          <ProgressBar Grid.Column="1"
                       Classes="ft4-slot"
                       Classes.tx="{Binding IsTxSlot}"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding SlotProgressPercent}" />
          <TextBlock Grid.Column="2"
                     Text="{Binding SlotProgressText}"
                     Classes="ft4-mono"
                     MinWidth="52"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    Spacing="14"
                    VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{loc:Localize Key=Ft4.SlotClock}"
                       Classes="ft4-status-label" />
            <TextBlock Text="{Binding SlotClockText}"
                       Classes="ft4-mono"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ClockSourceText}"
                       Classes="ft4-status-label"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{loc:Localize Key=Ft4.DopplerUplink}"
                       Classes="ft4-status-label" />
            <TextBlock Text="{Binding DopplerUplinkText}"
                       Classes="ft4-mono" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{loc:Localize Key=Ft4.DopplerDownlink}"
                       Classes="ft4-status-label" />
            <TextBlock Text="{Binding DopplerDownlinkText}"
                       Classes="ft4-mono" />
          </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <TextBlock Grid.Column="0"
                     Text="{loc:Localize Key=Ft4.Status}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="{Binding StatusLine}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="{Binding ManualPttPrompt}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PassInProgressBadgeForegroundBrush}"
                     VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <Grid RowDefinitions="*,Auto" RowSpacing="8">
      <!-- Decodes -->
      <Border Grid.Row="0" Classes="ft4-panel" Padding="8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top"
                     Margin="0,0,0,8"
                     LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="{loc:Localize Key=Ft4.Decodes}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8">
              <Button Content="{loc:Localize Key=Ft4.ClearDecodes}"
                      Command="{Binding ClearDecodesCommand}"
                      MinWidth="90" />
              <Button Content="{loc:Localize Key=Ft4.SaveActivity}"
                      Command="{Binding SaveActivityCommand}"
                      MinWidth="110" />
              <Button Content="{loc:Localize Key=Ft4.OpenSettings}"
                      Click="OnSettingsClick"
                      MinWidth="96" />
            </StackPanel>
          </DockPanel>

          <Grid x:Name="DecodeColumns" ColumnDefinitions="*,Auto,0">
            <DockPanel Grid.Column="0" Grid.IsSharedSizeScope="True">
              <TextBlock DockPanel.Dock="Top"
                         Text="{loc:Localize Key=Ft4.Decodes.BandActivity}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Margin="4,0,4,4"
                         IsVisible="{Binding IsAdvancedDecodeLayout}" />
              <ContentControl DockPanel.Dock="Top"
                              Content="{Binding}"
                              ContentTemplate="{StaticResource Ft4DecodeHeaderTemplate}" />
              <ListBox x:Name="DecodeList"
                       Classes="ft4-decodes"
                       ItemsSource="{Binding Decodes}"
                       SelectedItem="{Binding SelectedDecode}"
                       ItemTemplate="{StaticResource Ft4DecodeRowTemplate}"
                       FontSize="{Binding DecodeFontSize}">
                <!-- A virtualizing panel painted the newest rows twice while the list
                     was pulled back to the top. Scrolling rebuilt it and the copies vanished. -->
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ContextMenu>
                  <ContextMenu Opening="OnDecodeContextMenuOpening"
                               Closed="OnDecodeContextMenuClosed">
                    <MenuItem Header="{loc:Localize Key=Ft4.Pounce.OnStation}"
                              Click="OnPounceOnStationClick" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </DockPanel>

            <GridSplitter x:Name="DecodeColumnsSplitter"
                          Grid.Column="1"
                          Width="10"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          IsVisible="{Binding IsAdvancedDecodeLayout}" />

            <DockPanel Grid.Column="2"
                       Grid.IsSharedSizeScope="True"
                       IsVisible="{Binding IsAdvancedDecodeLayout}">
              <TextBlock DockPanel.Dock="Top"
                         Text="{loc:Localize Key=Ft4.Decodes.CallingMe}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Margin="4,0,4,4" />
              <ContentControl DockPanel.Dock="Top"
                              Content="{Binding}"
                              ContentTemplate="{StaticResource Ft4DecodeHeaderTemplate}" />
              <ListBox x:Name="CallsToMeList"
                       Classes="ft4-decodes"
                       ItemsSource="{Binding CallsToMe}"
                       SelectedItem="{Binding SelectedCallToMe}"
                       ItemTemplate="{StaticResource Ft4DecodeRowTemplate}"
                       FontSize="{Binding DecodeFontSize}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ContextMenu>
                  <ContextMenu Opening="OnDecodeContextMenuOpening"
                               Closed="OnDecodeContextMenuClosed">
                    <MenuItem Header="{loc:Localize Key=Ft4.Pounce.OnStation}"
                              Click="OnPounceOnStationClick" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- TX -->
      <Border Grid.Row="1" Classes="ft4-panel" Padding="10">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Text="{loc:Localize Key=Ft4.TxMessage}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <TextBox Grid.Column="1"
                     Text="{Binding CurrentTxMessage, Mode=TwoWay}"
                     FontFamily="Consolas,Courier New,monospace"
                     Watermark="{Binding TxMessageWatermark}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Localize Key=Ft4.EnableTx}"
                    Command="{Binding EnableTxCommand}"
                    MinWidth="100" />
            <Button Content="{loc:Localize Key=Ft4.HaltTx}"
                    Command="{Binding HaltTxCommand}"
                    Classes.accent="{Binding TxEnabled}"
                    MinWidth="100" />
            <Button Content="{loc:Localize Key=Ft4.Tune}"
                    Command="{Binding TuneCommand}"
                    Classes.accent="{Binding IsTuning}"
                    MinWidth="88" />
            <Button Content="{loc:Localize Key=Ft4.CallCq}"
                    Command="{Binding StartCqCommand}"
                    MinWidth="100" />
            <Button Content="{loc:Localize Key=Ft4.SendReport}"
                    Command="{Binding SendReportCommand}"
                    MinWidth="100" />
            <Button Content="{loc:Localize Key=Ft4.Send73}"
                    Command="{Binding Send73Command}"
                    MinWidth="72" />
            <Button Content="{loc:Localize Key=Ft4.ManualLog}"
                    Command="{Binding ManualLogCommand}"
                    MinWidth="100" />
            <CheckBox Content="{loc:Localize Key=Ft4.SkipRrr}"
                      IsChecked="{Binding SkipRrr}"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0" />
          </StackPanel>

          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
              <CheckBox Content="{loc:Localize Key=Ft4.PreferEvenSlot}"
                        IsChecked="{Binding PreferEvenSlot}"
                        VerticalAlignment="Center" />
              <CheckBox Content="{loc:Localize Key=Ft4.HoldTxFrequency}"
                        IsChecked="{Binding HoldTxFrequency}"
                        ToolTip.Tip="{loc:Localize Key=Ft4.HoldTxFrequency.Note}"
                        VerticalAlignment="Center" />
              <CheckBox Content="{loc:Localize Key=Ft4.AutoReply}"
                        IsChecked="{Binding AutoReply, Mode=TwoWay}"
                        ToolTip.Tip="{loc:Localize Key=Ft4.AutoReply.Note}"
                        VerticalAlignment="Center" />
              <CheckBox x:Name="PounceCheckBox"
                        Content="{Binding PounceCheckLabel}"
                        IsChecked="{Binding IsPounceArmed, Mode=OneWay}"
                        Click="OnPounceCheckClick"
                        ToolTip.Tip="{loc:Localize Key=Ft4.Pounce.Note}"
                        AutomationProperties.Name="{Binding PounceCheckLabel}"
                        VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
              <TextBlock Text="{loc:Localize Key=Ft4.TxAudioHz}"
                         VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding TxAudioHz}"
                             Minimum="200"
                             Maximum="3000"
                             Increment="10"
                             FormatString="0"
                             MinWidth="128"
                             Width="128" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </Grid>
    </DockPanel>
  </DockPanel>
</Window>
