<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:models="using:OscarWatch.Core.Models"
        xmlns:loc="using:OscarWatch.Localization"
        x:Class="OscarWatch.Views.LogbookSettingsWindow"
        x:DataType="vm:LogbookSettingsViewModel"
        Title="{loc:Localize Key=Window.LogbookSettings.Title}"
        Width="600"
        SizeToContent="Height"
        MinWidth="480"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <TextBlock Text="{Binding ErrorText}"
                 TextWrapping="Wrap"
                 Foreground="#FFC07070"
                 IsVisible="{Binding HasError}" />
      <TextBlock Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 IsVisible="{Binding HasStatus}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{loc:Localize Key=Common.Cancel}"
                Classes="dialog-footer"
                Click="OnCancelClick"
                IsCancel="True" />
        <Button Content="{loc:Localize Key=Common.Save}"
                Classes="dialog-footer accent"
                Click="OnSaveClick"
                IsDefault="True"
                IsEnabled="{Binding CanSaveStationProfile}" />
      </StackPanel>
    </StackPanel>

    <TabControl Margin="0,0,0,4">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="TabItem TextBlock">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem ScrollViewer StackPanel > TextBlock">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TabItem ScrollViewer > TextBlock">
          <Setter Property="FontSize" Value="11" />
          <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TabItem ScrollViewer > StackPanel">
          <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
      </TabControl.Styles>
      <TabItem Header="{loc:Localize Key=Settings.Tab.Cloudlog}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="480">
            <TextBlock Text="{loc:Localize Key=Settings.Cloudlog.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.UrlLabel}" />
              <TextBox Text="{Binding CloudlogUrlSummary}"
                       IsReadOnly="True" />
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.UrlNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <CheckBox Content="{loc:Localize Key=Logbook.Settings.Cloudlog.AutoUpload}"
                      IsChecked="{Binding CloudlogAutoUpload, Mode=TwoWay}"
                      IsEnabled="{Binding CloudlogConfigured}" />
            <StackPanel Spacing="4" IsEnabled="{Binding CloudlogConfigured}">
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.StationProfile}" />
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding StationProfiles}"
                          SelectedItem="{Binding SelectedStationProfile, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !IsLoadingProfiles}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:CloudlogStationProfile">
                      <TextBlock Text="{Binding DisplayLabel}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{loc:Localize Key=Logbook.Settings.Cloudlog.RefreshProfiles}"
                        Command="{Binding RefreshStationProfilesCommand}"
                        IsEnabled="{Binding !IsLoadingProfiles}" />
              </Grid>
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cloudlog.StationProfileNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <Button Content="{loc:Localize Key=Logbook.Settings.Cloudlog.RetryFailed}"
                    Command="{Binding RetryFailedUploadsCommand}"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding CloudlogConfigured}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Localize Key=Settings.Tab.Qrz}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="480">
            <TextBlock Text="{loc:Localize Key=Settings.Qrz.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Qrz.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <CheckBox Content="{loc:Localize Key=Settings.Qrz.Enable}"
                      IsChecked="{Binding QrzEnabled, Mode=TwoWay}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.Qrz.Username}" />
              <TextBox Text="{Binding QrzUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="{loc:Localize Key=Settings.Qrz.UsernameWatermark}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.Qrz.Password}" />
              <TextBox Text="{Binding QrzPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="•"
                       Watermark="{loc:Localize Key=Settings.Qrz.PasswordWatermark}" />
            </StackPanel>
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Qrz.CredentialsNote}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Content="{loc:Localize Key=Settings.Qrz.TestConnection}"
                    Command="{Binding TestQrzCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding QrzTestStatus}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       MinHeight="20"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       IsVisible="{Binding HasQrzStatus}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Localize Key=Settings.Tab.HamQth}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="480">
            <TextBlock Text="{loc:Localize Key=Settings.HamQth.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.HamQth.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <CheckBox Content="{loc:Localize Key=Settings.HamQth.Enable}"
                      IsChecked="{Binding HamQthEnabled, Mode=TwoWay}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.HamQth.Username}" />
              <TextBox Text="{Binding HamQthUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       Watermark="{loc:Localize Key=Settings.HamQth.UsernameWatermark}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize Key=Settings.HamQth.Password}" />
              <TextBox Text="{Binding HamQthPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PasswordChar="•"
                       Watermark="{loc:Localize Key=Settings.HamQth.PasswordWatermark}" />
            </StackPanel>
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.HamQth.CredentialsNote}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Content="{loc:Localize Key=Settings.HamQth.TestConnection}"
                    Command="{Binding TestHamQthCommand}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding HamQthTestStatus}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       MinHeight="20"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       IsVisible="{Binding HasHamQthStatus}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{loc:Localize Key=Logbook.Settings.Cw.Tab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,0">
          <StackPanel Spacing="14" MaxWidth="560">
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.Section}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.Intro}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <CheckBox Content="{loc:Localize Key=Logbook.Settings.Cw.Enable}"
                      IsChecked="{Binding CwEnabled, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding CwWpm, Mode=TwoWay}"
                             Minimum="5" Maximum="60" Increment="1"
                             FormatString="0"
                             Width="120"
                             AutomationProperties.Name="{loc:Localize Key=Logbook.Cw.WpmToolTip}" />
              <TextBlock Text="{loc:Localize Key=Logbook.Cw.Wpm}"
                         VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.Keying}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding CwUplinkText}" />
              <TextBlock Text="{Binding CwRouteText}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.KenwoodNote}"
                       IsVisible="{Binding CwIsKenwoodUplink}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <StackPanel Spacing="4" IsVisible="{Binding CwIsIcomTextUplink}">
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.IcomNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <CheckBox Content="{loc:Localize Key=Logbook.Settings.Cw.IcomUseLine}"
                        IsChecked="{Binding CwUseComLineOnTextRadios, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="10" IsVisible="{Binding CwShowLineOptions}">
              <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.KeyLine}" />
                <ComboBox ItemsSource="{Binding CwKeyLineOptions}"
                          SelectedIndex="{Binding CwKeyLineIndex, Mode=TwoWay}"
                          Width="120"
                          AutomationProperties.Name="{loc:Localize Key=Logbook.Settings.Cw.KeyLine}" />
              </StackPanel>
              <CheckBox Content="{loc:Localize Key=Logbook.Settings.Cw.UseSeparatePort}"
                        IsChecked="{Binding CwUseSeparatePort, Mode=TwoWay}" />
              <StackPanel Spacing="4" IsVisible="{Binding CwUseSeparatePort}">
                <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.Port}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ComboBox Grid.Column="0"
                            ItemsSource="{Binding CwPortOptions}"
                            SelectedItem="{Binding CwSeparatePort, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{loc:Localize Key=Logbook.Settings.Cw.Port}" />
                  <Button Grid.Column="1"
                          Content="{loc:Localize Key=Logbook.Settings.Cw.RefreshPorts}"
                          Command="{Binding RefreshCwPortsCommand}" />
                </Grid>
              </StackPanel>
              <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.LineNote}"
                         TextWrapping="Wrap"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding CwWarningText}"
                       IsVisible="{Binding CwShowWarning}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#FFC07070" />

            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.Messages}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <Grid ColumnDefinitions="36,120,*" ColumnSpacing="8">
              <TextBlock Grid.Column="1"
                         Text="{loc:Localize Key=Logbook.Settings.Cw.ButtonName}"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              <TextBlock Grid.Column="2"
                         Text="{loc:Localize Key=Logbook.Settings.Cw.Message}"
                         FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding CwMessages}" Margin="0,-8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CwMessageRowViewModel">
                  <Grid ColumnDefinitions="36,120,*" ColumnSpacing="8" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0"
                               Text="{Binding KeyName}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding Label, Mode=TwoWay}"
                             MaxLength="{Binding MaxLabelLength}"
                             AutomationProperties.Name="{loc:Localize Key=Logbook.Settings.Cw.ButtonName}" />
                    <TextBox Grid.Column="2"
                             Text="{Binding Text, Mode=TwoWay}"
                             MaxLength="{Binding MaxMessageLength}"
                             FontFamily="Consolas,Courier New,monospace"
                             AutomationProperties.Name="{loc:Localize Key=Logbook.Settings.Cw.Message}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:Localize Key=Logbook.Settings.Cw.Tokens}"
                       TextWrapping="Wrap"
                       FontSize="11"
                       FontFamily="Consolas,Courier New,monospace"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Content="{loc:Localize Key=Logbook.Settings.Cw.Help}"
                    Command="{Binding OpenCwHelpCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
