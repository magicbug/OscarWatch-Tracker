<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:loc="using:OscarWatch.Localization"
        xmlns:ctrl="using:OscarWatch.Controls"
        x:Class="OscarWatch.Views.UpcomingPassesWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Localize Key=Window.UpcomingPasses.Title}"
        Width="420" Height="640"
        MinWidth="320" MinHeight="280"
        WindowStartupLocation="CenterOwner">
  <ctrl:UpcomingPassesListControl Margin="8" />
</Window>
