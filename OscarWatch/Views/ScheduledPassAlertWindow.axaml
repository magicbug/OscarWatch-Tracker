<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OscarWatch.Localization"
        xmlns:ctrl="using:OscarWatch.Controls"
        x:Class="OscarWatch.Views.ScheduledPassAlertWindow"
        Title="{loc:Localize Key=Pass.Schedule.AlertTitle}"
        Width="640"
        SizeToContent="Height"
        MinWidth="560"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
  <Border Padding="20"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <Button x:Name="OkButton"
                Content="{loc:Localize Key=Common.Ok}"
                Classes="dialog-footer accent"
                MinWidth="100"
                IsDefault="True"
                IsCancel="True"
                Click="OnOkClick" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="16">
        <StackPanel Grid.Column="0"
                    Spacing="10"
                    VerticalAlignment="Center"
                    MinWidth="220">
          <Border Background="{DynamicResource PassImminentBadgeBackgroundBrush}"
                  CornerRadius="4"
                  Padding="10,4"
                  HorizontalAlignment="Left">
            <TextBlock Text="{loc:Localize Key=Pass.Schedule.AlertBadge}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PassImminentBadgeForegroundBrush}" />
          </Border>

          <TextBlock x:Name="SatelliteNameText"
                     FontSize="22"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource ThemeForegroundBrush}" />

          <TextBlock x:Name="CountdownText"
                     FontSize="16"
                     FontWeight="SemiBold"
                     FontFamily="Consolas,Courier New,monospace"
                     Foreground="{DynamicResource ThemeForegroundBrush}" />

          <TextBlock x:Name="AosTimeText"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
        </StackPanel>

        <Border x:Name="PolarPlotHost"
                Grid.Column="1"
                Width="220"
                Height="220"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ClipToBounds="True">
          <ctrl:PassPolarPlotControl x:Name="PolarPlot"
                                     Width="220"
                                     Height="220"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
