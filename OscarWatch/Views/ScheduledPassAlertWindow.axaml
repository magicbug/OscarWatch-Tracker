<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OscarWatch.Localization"
        x:Class="OscarWatch.Views.ScheduledPassAlertWindow"
        Title="{loc:Localize Key=Pass.Schedule.AlertTitle}"
        Width="420"
        SizeToContent="Height"
        MinWidth="360"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
  <Border Padding="20"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,20,0,0">
        <Button x:Name="OkButton"
                Content="{loc:Localize Key=Common.Ok}"
                Classes="dialog-footer accent"
                MinWidth="100"
                IsDefault="True"
                IsCancel="True"
                Click="OnOkClick" />
      </StackPanel>

      <StackPanel Spacing="10">
        <Border Background="{DynamicResource PassImminentBadgeBackgroundBrush}"
                CornerRadius="4"
                Padding="10,4"
                HorizontalAlignment="Left">
          <TextBlock Text="{loc:Localize Key=Pass.Schedule.AlertBadge}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource PassImminentBadgeForegroundBrush}" />
        </Border>

        <TextBlock x:Name="SatelliteNameText"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeForegroundBrush}" />

        <TextBlock x:Name="CountdownText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   FontFamily="Consolas,Courier New,monospace"
                   Foreground="{DynamicResource ThemeForegroundBrush}" />

        <TextBlock x:Name="AosTimeText"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
