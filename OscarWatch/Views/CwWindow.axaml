<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OscarWatch.ViewModels"
        xmlns:cw="using:OscarWatch.Cw"
        xmlns:loc="using:OscarWatch.Localization"
        xmlns:controls="using:OscarWatch.Controls"
        x:Class="OscarWatch.Views.CwWindow"
        x:DataType="vm:CwViewModel"
        Title="{loc:Localize Key=Window.Cw.Title}"
        Width="960" Height="640"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.cw-panel">
      <Setter Property="Background" Value="{DynamicResource ThemeSubtlePanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.cw-divider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="6,0,12,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="TextBlock.cw-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.cw-mono">
      <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.cw-copy">
      <Setter Property="FontFamily" Value="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cw-chip">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cw-legend">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Border.cw-legend > TextBlock">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.cw-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cw-link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.cw-link:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.cw-link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="10">
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="cw-panel" Padding="8" Margin="0,0,0,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="{loc:Localize Key=Cw.OpenSettings}"
                  Click="OnSettingsClick"
                  Margin="8,0,0,4" />
          <Button Content="{loc:Localize Key=Cw.Help}"
                  Command="{Binding OpenHelpCommand}"
                  ToolTip.Tip="{loc:Localize Key=Cw.Help.Tip}"
                  Margin="6,0,0,4" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button Content="{loc:Localize Key=Cw.Start}"
                  Command="{Binding StartCommand}"
                  Classes="accent"
                  MinWidth="80"
                  Margin="0,0,6,4" />
          <Button Content="{loc:Localize Key=Cw.Stop}"
                  Command="{Binding StopCommand}"
                  MinWidth="80"
                  Margin="0,0,6,4" />
          <Border Classes="cw-divider" />
          <Button Content="{loc:Localize Key=Cw.Clear}"
                  Command="{Binding ClearCommand}"
                  ToolTip.Tip="{loc:Localize Key=Cw.Clear.Tip}"
                  ToolTip.ShowOnDisabled="True"
                  Margin="0,0,6,4" />
          <Button Content="{loc:Localize Key=Cw.SaveCopy}"
                  Command="{Binding SaveCopyCommand}"
                  ToolTip.Tip="{loc:Localize Key=Cw.SaveCopy.Tip}"
                  ToolTip.ShowOnDisabled="True"
                  Margin="0,0,6,4" />
        </WrapPanel>
      </DockPanel>
    </Border>

    <!-- Status strip -->
    <Border DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,8,2"
            Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="8"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock Text="{loc:Localize Key=Cw.Level}"
                       Classes="cw-label"
                       TextWrapping="NoWrap" />
            <ProgressBar Minimum="0" Maximum="100"
                         Value="{Binding InputLevelPercent}"
                         Width="140" MinWidth="140" MaxWidth="140"
                         Height="10" MinHeight="10"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="{loc:Localize Key=Cw.Level}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusText}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </DockPanel>
        <WrapPanel Orientation="Horizontal">
          <TextBlock Text="{Binding ToneText}" Classes="cw-mono" Margin="0,0,18,0"
                     FontWeight="{Binding ToneOutOfBand, Converter={x:Static vm:CwViewModel.BoolToEmphasis}}"
                     IsVisible="{Binding ToneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding SpeedText}" Classes="cw-mono" Margin="0,0,18,0"
                     IsVisible="{Binding SpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding DopplerText}" Classes="cw-mono" Margin="0,0,18,0"
                     IsVisible="{Binding DopplerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding LagText}" Classes="cw-mono"
                     IsVisible="{Binding IsRunning}" />
        </WrapPanel>
        <TextBlock Text="{Binding LogbookText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding LogbookText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- Waterfall -->
    <Border DockPanel.Dock="Top" Classes="cw-panel" Padding="6" Margin="0,0,0,8">
      <controls:CwWaterfallControl Height="130"
                                   Spectrum="{Binding Spectrum}"
                                   ToneHz="{Binding ToneHz}"
                                   x:Name="Waterfall"
                                   BandOffsetHz="{Binding BandOffsetHz}"
                                   ToolTip.Tip="{loc:Localize Key=Cw.Waterfall.Tip}"
                                   AutomationProperties.Name="{loc:Localize Key=Cw.Waterfall}" />
    </Border>

    <!-- Copy -->
    <Border Classes="cw-panel">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:Localize Key=Cw.Copy.Hint}"
                   Classes="cw-label"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Border Classes="cw-legend" Background="{x:Static cw:CwCopyWord.NewCallBrush}">
            <TextBlock Text="{loc:Localize Key=Cw.Legend.NewCall}" />
          </Border>
          <Border Classes="cw-legend" Background="{x:Static cw:CwCopyWord.NewGridBrush}">
            <TextBlock Text="{loc:Localize Key=Cw.Legend.NewGrid}" />
          </Border>
          <Border Classes="cw-legend" Background="{x:Static cw:CwCopyWord.WorkedBrush}">
            <TextBlock Text="{loc:Localize Key=Cw.Legend.Worked}" />
          </Border>
          <Border Classes="cw-legend" Background="{x:Static cw:CwCopyWord.YouBrush}">
            <TextBlock Text="{loc:Localize Key=Cw.Legend.You}" />
          </Border>
        </WrapPanel>
        <ScrollViewer x:Name="CopyScroller"
                      FontSize="{Binding CopyFontSize}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="2" Margin="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="cw:CwCopyLine">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Stamp}"
                               Classes="cw-mono"
                               Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                               VerticalAlignment="Top"
                               Margin="0,3,12,0" />
                    <ItemsControl ItemsSource="{Binding Words}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.DataTemplates>
                        <DataTemplate DataType="cw:CwCopyLink">
                          <Button Classes="cw-link"
                                  Click="OnLinkClick"
                                  Margin="0,0,6,0"
                                  ToolTip.Tip="{Binding Tip}"
                                  AutomationProperties.Name="{Binding Tip}">
                            <Border Classes="cw-chip" Background="{Binding Background}">
                              <TextBlock Text="{Binding Text}"
                                         Classes="cw-copy"
                                         TextDecorations="Underline"
                                         FontWeight="{Binding IsCallsign, Converter={x:Static vm:CwViewModel.BoolToEmphasis}}" />
                            </Border>
                          </Button>
                        </DataTemplate>
                        <DataTemplate DataType="cw:CwCopyWord">
                          <Border Classes="cw-chip" Background="{Binding Background}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Text}" Classes="cw-copy" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.DataTemplates>
                    </ItemsControl>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PendingText}"
                       Classes="cw-copy"
                       FontStyle="Italic"
                       Foreground="{DynamicResource ThemeSecondaryForegroundBrush}"
                       ToolTip.Tip="{loc:Localize Key=Cw.Pending.Tip}"
                       IsVisible="{Binding PendingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
