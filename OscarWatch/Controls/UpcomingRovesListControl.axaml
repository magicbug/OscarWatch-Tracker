<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OscarWatch.ViewModels"
             xmlns:loc="using:OscarWatch.Localization"
             x:Class="OscarWatch.Controls.UpcomingRovesListControl"
             x:DataType="vm:MainViewModel"
             MinHeight="0"
             ClipToBounds="True">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,Auto" MinWidth="0" MinHeight="0">
    <!-- Grip is content chrome under the expander header, not part of the title bar. -->
    <Border x:Name="HamsAtRovesResizeGrip"
            Grid.Row="0"
            Height="8"
            Margin="0,2,0,4"
            Background="Transparent"
            Cursor="SizeNorthSouth"
            PointerPressed="OnHamsAtRovesResizePointerPressed"
            HorizontalAlignment="Stretch"
            ToolTip.Tip="{loc:Localize Key=Main.HamsAtRoves.ResizeGrip}">
      <Border Height="3"
              Width="36"
              CornerRadius="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Border>
    <TextBlock Grid.Row="1"
               Text="{Binding HamsAtRovesStatusText}"
               FontSize="15"
               TextWrapping="Wrap"
               Margin="0,0,0,4"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               IsVisible="{Binding ShowHamsAtRovesStatus}" />
    <ListBox x:Name="HamsAtRovesListBox"
             Grid.Row="2"
             ItemsSource="{Binding HamsAtRoves}"
             Tapped="OnHamsAtRovesListTapped"
             Padding="0"
             MinWidth="0"
             MinHeight="0"
             VerticalAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,2" />
          <Setter Property="MinHeight" Value="72" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Cursor" Value="Hand" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:HamsAtRoveRowViewModel">
          <Border Padding="10,8"
                  CornerRadius="3"
                  HorizontalAlignment="Stretch"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="3">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                  <Border Padding="10,4"
                          CornerRadius="10"
                          Background="{DynamicResource PassRecordingBadgeBackgroundBrush}"
                          IsVisible="{Binding ShowNeededGrids}">
                    <TextBlock Text="{Binding NeededGridsText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Consolas,Courier New,monospace"
                               Foreground="{DynamicResource PassRecordingBadgeForegroundBrush}" />
                  </Border>
                  <Border Padding="10,4"
                          CornerRadius="10"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                          BorderThickness="1"
                          IsVisible="{Binding ShowWorkedGrids}">
                    <TextBlock Text="{Binding WorkedGridsText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Consolas,Courier New,monospace"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                  </Border>
                  <Border Padding="10,4"
                          CornerRadius="10"
                          Background="{DynamicResource HamsAtGridBadgeBackgroundBrush}"
                          IsVisible="{Binding ShowGrids}">
                    <TextBlock Text="{Binding GridsText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Consolas,Courier New,monospace"
                               Foreground="{DynamicResource PassInProgressBadgeForegroundBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Callsign}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Padding="10,4"
                        CornerRadius="10"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding ShowSatellite}">
                  <TextBlock Text="{Binding SatelliteName}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             FontFamily="Consolas,Courier New,monospace" />
                </Border>
                <TextBlock Text="{Binding TimeWindowText}"
                           FontSize="15"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              </DockPanel>
              <TextBlock Text="{Binding Comment}"
                         FontSize="15"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ShowComment}"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
