<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OscarWatch.ViewModels"
             xmlns:loc="using:OscarWatch.Localization"
             xmlns:theme="using:OscarWatch.Theme"
             x:Class="OscarWatch.Controls.UpcomingPassesListControl"
             x:DataType="vm:MainViewModel"
             MinHeight="0"
             ClipToBounds="True">
  <ListBox x:Name="PassesListBox"
           ItemsSource="{Binding Passes}"
           TabIndex="3"
           Padding="0"
           MinWidth="0"
           MinHeight="0"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           ScrollViewer.VerticalScrollBarVisibility="Auto"
           AutoScrollToSelectedItem="False"
           SelectedItem="{Binding SelectedListItem, Mode=TwoWay}">
    <ListBox.ContextMenu>
      <ContextMenu Opening="OnPassesContextMenuOpening">
        <MenuItem Header="{loc:Localize Key=Pass.OpenVisualizer}"
                  Click="OnOpenPassVisualizerClick" />
        <MenuItem x:Name="SchedulePassMenuItem"
                  Click="OnToggleSchedulePassClick" />
        <MenuItem x:Name="PostHamsAtActivationMenuItem"
                  Header="{loc:Localize Key=Pass.HamsAt.PostActivation}"
                  Click="OnPostHamsAtActivationClick" />
      </ContextMenu>
    </ListBox.ContextMenu>
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <StackPanel />
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="ListBoxItem:not(.pass-day-header)">
        <Setter Property="MinHeight" Value="72" />
      </Style>
      <Style Selector="ListBoxItem.pass-day-header">
        <Setter Property="Margin" Value="0,8,0,2" />
      </Style>
      <Style Selector="ListBoxItem.pass-day-header:disabled">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,8,0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="ListBoxItem.pass-day-header:disabled TextBlock">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
      </Style>
    </ListBox.Styles>
    <ListBox.DataTemplates>
      <DataTemplate DataType="vm:PassDayHeaderViewModel">
        <Border Padding="0,4,0,2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
          <TextBlock Text="{Binding DateLabel}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource ThemeForegroundBrush}" />
        </Border>
      </DataTemplate>
      <DataTemplate DataType="vm:PassRowViewModel">
        <Border Padding="10,8"
                CornerRadius="4"
                HorizontalAlignment="Stretch"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                Background="{Binding Highlight, Converter={x:Static theme:PassRowBackgroundConverter.Instance}}">
          <StackPanel Spacing="3">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Right"
                      Padding="10,4"
                      CornerRadius="10"
                      Margin="6,0,0,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowBadge}"
                      Background="{Binding Highlight, Converter={x:Static theme:PassRowBadgeBackgroundConverter.Instance}}">
                <TextBlock Text="{Binding BadgeText}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="Consolas,Courier New,monospace"
                           Foreground="{Binding Highlight, Converter={x:Static theme:PassRowBadgeForegroundConverter.Instance}}" />
              </Border>
              <Button DockPanel.Dock="Right"
                      Padding="4,2"
                      Margin="6,0,0,0"
                      MinWidth="28"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowScheduleButton}"
                      Click="OnPassScheduleToggleClick"
                      ToolTip.Tip="{Binding ScheduleToolTip}"
                      AutomationProperties.Name="{Binding ScheduleAutomationName}">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding ScheduleGlyph}"
                           Foreground="{DynamicResource ThemeForegroundBrush}" />
              </Button>
              <Ellipse DockPanel.Dock="Left"
                       Width="8"
                       Height="8"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding ShowCommunityStatusDot}"
                       Opacity="{Binding CommunityStatusDotOpacity}"
                       ToolTip.Tip="{Binding CommunityStatusToolTip}"
                       AutomationProperties.Name="{Binding CommunityStatusAutomationName}"
                       Fill="{Binding CommunityStatusKind, Converter={x:Static theme:CommunityStatusDotFillConverter.Instance}}" />
              <TextBlock DockPanel.Dock="Right"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="{Binding ElementAgeText}"
                         IsVisible="{Binding ShowElementAge}"
                         Foreground="{DynamicResource StaleTleForegroundBrush}"
                         ToolTip.Tip="{Binding ElementAgeToolTip}"
                         AutomationProperties.Name="{Binding ElementAgeAutomationName}" />
              <TextBlock DockPanel.Dock="Right"
                         Margin="6,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Text="⚠"
                         IsVisible="{Binding ShowNotice}"
                         Foreground="{DynamicResource StaleTleForegroundBrush}"
                         ToolTip.Tip="{Binding NoticeToolTip}"
                         AutomationProperties.Name="{Binding NoticeAutomationName}" />
              <TextBlock Text="{Binding SatelliteName}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource ThemeForegroundBrush}" />
            </DockPanel>
            <TextBlock FontSize="14"
                       Text="{Binding TimeRangeLine}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ThemeForegroundBrush}" />
            <Grid ColumnDefinitions="*,*">
              <TextBlock Grid.Column="0"
                         FontSize="13"
                         Margin="0,0,8,0"
                         Text="{Binding DurationText}"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
              <TextBlock Grid.Column="1"
                         FontSize="13"
                         Text="{Binding MaxElevationText}"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource ThemeSecondaryForegroundBrush}" />
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ListBox.DataTemplates>
  </ListBox>
</UserControl>
