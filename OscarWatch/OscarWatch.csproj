<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.6</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icons\OscarWatch.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="PortAudioSharp2" Version="1.0.6" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.8" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.8" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OscarWatch.Core\OscarWatch.Core.csproj" />
    <ProjectReference Include="..\OscarWatch.Orbit\OscarWatch.Orbit.csproj" />
    <ProjectReference Include="..\OscarWatch.PortAudioProbe\OscarWatch.PortAudioProbe.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="BuildPortAudioProbe" AfterTargets="Build">
    <MSBuild Projects="..\OscarWatch.PortAudioProbe\OscarWatch.PortAudioProbe.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />
  </Target>

  <Target Name="CopyPortAudioProbeToOutput" AfterTargets="BuildPortAudioProbe">
    <PropertyGroup>
      <_ProbeOutputDir>..\OscarWatch.PortAudioProbe\bin\$(Configuration)\net10.0\</_ProbeOutputDir>
      <_ProbeOutputDir Condition="'$(RuntimeIdentifier)' != ''">..\OscarWatch.PortAudioProbe\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\publish\</_ProbeOutputDir>
      <_ProbeOutputDir Condition="'$(RuntimeIdentifier)' != '' and !Exists('$(_ProbeOutputDir)OscarWatch.PortAudioProbe.dll')">..\OscarWatch.PortAudioProbe\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\</_ProbeOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_ProbeFiles Include="$(_ProbeOutputDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProbeFiles)"
          DestinationFiles="@(_ProbeFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_ProbeOutputDir)OscarWatch.PortAudioProbe.dll') Or Exists('$(_ProbeOutputDir)OscarWatch.PortAudioProbe')" />
  </Target>

  <Target Name="PublishPortAudioProbe" AfterTargets="Publish">
    <MSBuild Projects="..\OscarWatch.PortAudioProbe\OscarWatch.PortAudioProbe.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishDir=$(PublishDir)" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Remove="Assets\AprsSymbols\COPYRIGHT.md" />
    <AvaloniaResource Include="icons\**" />
    <Content Include="Assets\satellite_database.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tle-seed.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\cty.dat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\dxcc-prefix-map.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Local builds copy every native library that is already in the tree.
         A RID publish copies only that platform, and keeps it as a real file
         (single-file Windows would otherwise hide it inside the exe). -->
    <Content Include="runtimes\**\native\oscarwatch_ft8.*" Condition="'$(RuntimeIdentifier)' == ''">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="runtimes\$(RuntimeIdentifier)\native\oscarwatch_ft8.*" Condition="'$(RuntimeIdentifier)' != ''">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>runtimes\$(RuntimeIdentifier)\native\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
